<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd">

    <ui:Style src="Theme.uss" />
    <ui:Style src="TouchControls.uss" />

    <!-- The driving controls are invisible screen regions handled by PlayerBikeInput:
         drag the left half to steer, press upper-right for throttle, lower-right to
         brake, both to handbrake. That scheme stays - a relative drag beats a fixed
         stick on a bike. What is drawn here is the two things gestures cannot carry:
         a hint of where those regions are, and real buttons for discrete actions.

         picking-mode="Ignore" on everything that is not a button matters. A full-screen
         container that swallows pointer events would block every touch from reaching
         the driving regions underneath and the bike would simply stop responding. -->
    <ui:VisualElement name="TouchRoot" class="touch-root" picking-mode="Ignore">

        <!-- Zone hints. Faded out by TouchControlsScreen after a few seconds of play, so
             a first-time player can see the layout and everyone else gets a clean screen. -->
        <ui:VisualElement name="ZoneHints" class="zone-hints" picking-mode="Ignore">
            <ui:VisualElement class="zone zone-attack" picking-mode="Ignore">
                <ui:Label text="SWING  ·  HOLD TO KICK" class="zone-label" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="zone-row" picking-mode="Ignore">
                <ui:VisualElement class="zone zone-steer" picking-mode="Ignore">
                    <ui:Label text="DRAG TO STEER" class="zone-label" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement class="zone-column" picking-mode="Ignore">
                    <ui:VisualElement class="zone zone-throttle" picking-mode="Ignore">
                        <ui:Label text="THROTTLE" class="zone-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="zone zone-brake" picking-mode="Ignore">
                        <ui:Label text="BRAKE" class="zone-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Pause. Sits in the dead notch PlayerBikeInput carves out of the centre of the
             attack strip, so pressing it cannot also read as a swing. Before this existed
             there was no touch path to PauseScreen.TogglePause at all - the pause menu was
             fully implemented and unreachable on a phone. -->
        <ui:Button name="BtnPause" text="II" class="touch-button pause-button" />

        <!-- Discrete actions. Grab is a timing window and needs a button, not a gesture:
             a gesture you have to read under pressure is a gesture you will miss. -->
        <ui:VisualElement name="ActionCluster" class="action-cluster" picking-mode="Ignore">
            <ui:Button name="BtnNitro" text="NITRO" class="touch-button action-button-nitro" />
            <ui:Button name="BtnGrab" text="GRAB" class="touch-button action-button-grab" />
            <ui:Button name="BtnKick" text="KICK" class="touch-button action-button-kick" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
