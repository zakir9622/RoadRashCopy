<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd">
    
    <!-- Theme first: GameUI.uss now references the shared accent, panel and danger
         custom properties rather than re-declaring the same hex values, so the sheet
         that defines them has to be attached. -->
    <ui:Style src="Theme.uss" />
    <ui:Style src="GameUI.uss" />

    <ui:VisualElement class="hud-container">
        <!-- Top Left: Position & distance to the finish.
             Not laps: RaceManager has no concept of one. The race is point-to-point
             down a highway, so "LAP 1 / 3" could never have been anything but a
             decorative lie. Distance remaining is the number that actually exists. -->
        <ui:VisualElement class="top-left-panel panel">
            <ui:Label text="POS" class="label-small" />
            <ui:Label name="PositionLabel" text="1 / 8" class="label-large accent-color" />
            <ui:Label text="TO FINISH" class="label-small mt-2" />
            <ui:Label name="DistanceLabel" text="-" class="label-medium" />
        </ui:VisualElement>

        <!-- Top Right: cash (the through-line) and knockouts banked this race -->
        <ui:VisualElement class="top-right-panel panel">
            <ui:Label text="CASH" class="label-small" />
            <ui:Label name="CashLabel" text="$0" class="label-medium text-right cash-color" />
            <ui:Label text="KNOCKOUTS" class="label-small mt-2" />
            <ui:Label name="KnockoutLabel" text="0" class="label-medium text-right" />
        </ui:VisualElement>

        <!-- Bottom Right: Speedometer, with the nitrous meter under it (held, drains) -->
        <ui:VisualElement class="bottom-right-panel panel">
            <ui:Label name="SpeedLabel" text="0" class="label-xlarge" />
            <ui:Label text="KM/H" class="label-small text-right" />
            <ui:Label name="GearLabel" text="N" class="label-medium text-right mt-1 accent-color" />
            <ui:Label text="NITRO" class="label-small text-right mt-2" />
            <ui:VisualElement class="nitro-bar-bg mt-1">
                <ui:VisualElement name="NitrousBarFill" class="nitro-bar-fill" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom Left: Health -->
        <ui:VisualElement class="bottom-left-panel panel">
            <ui:Label text="BIKE CONDITION" class="label-small" />
            <ui:VisualElement class="health-bar-bg mt-1">
                <ui:VisualElement name="HealthBarFill" class="health-bar-fill" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Center: Rear View Mirror (Placeholder for render texture) -->
        <ui:VisualElement class="rear-view-mirror panel">
            <ui:Label text="REAR VIEW" class="label-small center-text" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
