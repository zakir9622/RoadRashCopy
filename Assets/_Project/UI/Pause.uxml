<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd">

    <ui:Style src="Theme.uss" />

    <ui:VisualElement class="screen scrim">
        <ui:VisualElement class="panel-centred">

            <ui:Label text="PAUSED" class="title" />

            <!-- Volume lives here as well as in the settings screen: reaching for the
                 volume mid-race is the single most common reason to pause at all, and
                 sending the player out to a separate screen to do it means abandoning
                 the race. Both paths write through the same SettingsBinding. -->
            <ui:VisualElement class="setting-row">
                <ui:Label text="MUSIC VOLUME" />
                <ui:Slider name="MusicVolume" low-value="0" high-value="1" />
            </ui:VisualElement>

            <ui:VisualElement class="setting-row">
                <ui:Label text="SFX VOLUME" />
                <ui:Slider name="SfxVolume" low-value="0" high-value="1" />
            </ui:VisualElement>

            <ui:VisualElement class="setting-row">
                <ui:Label text="VIBRATION" />
                <ui:Toggle name="Vibration" />
            </ui:VisualElement>

            <ui:VisualElement class="button-row">
                <ui:Button name="BtnResume" text="RESUME" class="action-button" />
                <ui:Button name="BtnRestart" text="RESTART" class="action-button" />
                <ui:Button name="BtnQuit" text="QUIT TO MENU" class="action-button" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
