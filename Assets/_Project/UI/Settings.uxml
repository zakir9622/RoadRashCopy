<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd">

    <ui:Style src="Theme.uss" />

    <!-- Modal over whatever screen opened it. The scrim covers the full area so clicks
         cannot reach the menu buttons underneath while this is up. -->
    <ui:VisualElement class="screen scrim">
        <ui:VisualElement class="panel-centred">

            <ui:Label text="SETTINGS" class="title" />

            <ui:VisualElement class="setting-row">
                <ui:Label text="MASTER VOLUME" />
                <ui:Slider name="MasterVolume" low-value="0" high-value="1" />
            </ui:VisualElement>

            <ui:VisualElement class="setting-row">
                <ui:Label text="MUSIC VOLUME" />
                <ui:Slider name="MusicVolume" low-value="0" high-value="1" />
            </ui:VisualElement>

            <ui:VisualElement class="setting-row">
                <ui:Label text="SFX VOLUME" />
                <ui:Slider name="SfxVolume" low-value="0" high-value="1" />
            </ui:VisualElement>

            <ui:VisualElement class="setting-row">
                <ui:Label text="TILT STEERING" />
                <ui:Toggle name="TiltSteering" />
            </ui:VisualElement>

            <ui:VisualElement class="setting-row">
                <ui:Label text="VIBRATION" />
                <ui:Toggle name="Vibration" />
            </ui:VisualElement>

            <ui:VisualElement class="button-row">
                <ui:Button name="BtnClose" text="CLOSE" class="action-button" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
