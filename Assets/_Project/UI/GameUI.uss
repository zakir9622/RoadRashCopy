.hud-container {
    width: 100%;
    height: 100%;
    position: absolute;
    justify-content: space-between;
    padding: 30px;
    color: white;
    font-size: 16px;
    -unity-font-definition: initial; /* Use default font for now, replace with custom gritty font later */
}

.panel {
    background-color: rgba(10, 15, 20, 0.7);
    border-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-radius: 8px;
    padding: 15px;
    -unity-font-style: bold;
}

.top-left-panel {
    position: absolute;
    top: 30px;
    left: 30px;
    width: 150px;
}

.top-right-panel {
    position: absolute;
    top: 30px;
    right: 30px;
    width: 180px;
}

.bottom-right-panel {
    position: absolute;
    bottom: 30px;
    right: 30px;
    width: 220px;
    align-items: flex-end;
}

.bottom-left-panel {
    position: absolute;
    bottom: 30px;
    left: 30px;
    width: 250px;
}

.rear-view-mirror {
    position: absolute;
    top: 20px;
    align-self: center;
    width: 400px;
    height: 80px;
    border-radius: 40px;
    background-color: rgba(0, 0, 0, 0.8);
    border-color: #00ffcc;
    border-width: 2px;
    justify-content: center;
}

.label-small {
    font-size: 14px;
    color: #a0a0a0;
    letter-spacing: 2px;
}

.label-medium {
    font-size: 24px;
    color: #ffffff;
}

.label-large {
    font-size: 36px;
}

.label-xlarge {
    font-size: 72px;
    color: #ffffff;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

.accent-color {
    color: #00ffcc; /* Cyberpunk/Neon cyan accent */
}

.text-right {
    -unity-text-align: middle-right;
}

.center-text {
    -unity-text-align: middle-center;
}

.mt-1 {
    margin-top: 5px;
}

.mt-2 {
    margin-top: 15px;
}

.health-bar-bg {
    width: 100%;
    height: 12px;
    background-color: rgba(0, 0, 0, 0.8);
    border-color: #333333;
    border-width: 1px;
    border-radius: 6px;
    overflow: hidden;
}

.health-bar-fill {
    width: 100%;
    height: 100%;
    background-color: #ff3366; /* Neon pink/red for health */
    border-radius: 5px;
    transition-property: width;
    transition-duration: 0.2s;
}
