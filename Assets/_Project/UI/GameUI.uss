/*
 * In-race HUD layout.
 *
 * The `-unity-font-definition: initial` that used to sit in .hud-container is gone. It
 * was a placeholder waiting for "a custom gritty font later", and now that the font is
 * fetched and set on PanelSettings, that declaration would have actively overridden it
 * back to Unity's built-in default for the whole HUD - the one screen where legibility
 * at a glance matters most.
 */
.hud-container {
    width: 100%;
    height: 100%;
    position: absolute;
    justify-content: space-between;
    padding: 30px;
    color: var(--ink);
    font-size: 16px;
}

.panel {
    background-color: var(--panel);
    border-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-radius: 8px;
    padding: 15px;
    -unity-font-style: bold;
}

.top-left-panel {
    position: absolute;
    top: 30px;
    left: 30px;
    width: 150px;
}

.top-right-panel {
    position: absolute;
    top: 30px;
    right: 30px;
    width: 180px;
}

.bottom-right-panel {
    position: absolute;
    bottom: 30px;
    right: 30px;
    width: 220px;
    align-items: flex-end;
}

.bottom-left-panel {
    position: absolute;
    bottom: 30px;
    left: 30px;
    width: 250px;
}

.stamina-bar-bg {
    width: 100%;
    height: 12px;
    background-color: rgba(0, 0, 0, 0.85);
    border-color: var(--accent-dim);
    border-width: 1px;
    border-radius: 6px;
    overflow: hidden;
}

.stamina-bar-fill {
    width: 100%;
    height: 100%;
    background-color: var(--accent);
    border-radius: 5px;
}

.mirror-row {
    position: absolute;
    top: 74px;
    align-self: center;
    flex-direction: row;
    justify-content: center;
}

.mirror-side {
    width: 180px;
    height: 64px;
    margin-left: 8px;
    margin-right: 8px;
    border-radius: 32px;
}

.rear-view-mirror {
    background-color: rgba(0, 0, 0, 0.85);
    border-color: var(--roadrash-blue);
    border-width: 2px;
    justify-content: center;
}

/* Police heat: a row of pips at top-centre that light police-blue as the wanted
   level climbs. Distinct blue so heat never reads as the cyan accent or red damage. */
.heat-panel {
    position: absolute;
    top: 20px;
    align-self: center;
    align-items: center;
}

.heat-label {
    color: rgb(47, 128, 255);
    letter-spacing: 3px;
    margin-bottom: 4px;
}

.heat-stars {
    flex-direction: row;
}

.heat-star {
    width: 15px;
    height: 15px;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.18);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.heat-star.on {
    background-color: rgb(47, 128, 255);
}

.label-small {
    font-size: 14px;
    color: var(--ink-muted);
    letter-spacing: 2px;
}

.label-medium {
    font-size: 24px;
    color: #ffffff;
}

.label-large {
    font-size: 36px;
}

.label-xlarge {
    font-size: 72px;
    color: #ffffff;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

.accent-color {
    color: var(--accent); /* Cyberpunk/Neon cyan accent */
}

.text-right {
    -unity-text-align: middle-right;
}

.center-text {
    -unity-text-align: middle-center;
}

.mt-1 {
    margin-top: 5px;
}

.mt-2 {
    margin-top: 15px;
}

.health-bar-bg {
    width: 100%;
    height: 12px;
    background-color: rgba(0, 0, 0, 0.8);
    border-color: #333333;
    border-width: 1px;
    border-radius: 6px;
    overflow: hidden;
}

.health-bar-fill {
    width: 100%;
    height: 100%;
    background-color: var(--danger); /* Neon pink/red for health */
    border-radius: 5px;
    transition-property: width;
    transition-duration: 0.2s;
}

/* Cash: the money through-line, a warm gold distinct from the cyan accent. */
.cash-color {
    color: rgb(255, 197, 61);
}

/* Nitrous meter: same bar frame as health, but full-width for the wider speed panel
   and a hot-orange fill so heat/boost reads differently from bike condition. */
.nitro-bar-bg {
    width: 100%;
    height: 10px;
    background-color: rgba(0, 0, 0, 0.8);
    border-color: #333333;
    border-width: 1px;
    border-radius: 5px;
    overflow: hidden;
}

.nitro-bar-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(255, 122, 24); /* nitro orange */
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.1s;
}

/* Live standings, stacked under the cash/knockouts panel on the right. */
.standings-panel {
    position: absolute;
    top: 176px;
    right: 30px;
    width: 180px;
}

.standing-row {
    font-size: 14px;
    color: #dddddd;
    letter-spacing: 1px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.standing-row.you {
    color: var(--accent);
}

/* Damage direction flash: a red glow down the screen edge a hit came from. Opacity is
   0 at rest and pulsed by the HUD, then faded back down. USS has no gradients, so this is
   a solid translucent edge band rather than a soft falloff. */
.damage-flash {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 160px;
    opacity: 0;
    background-color: rgba(255, 59, 78, 0.5);
}

.damage-flash--left {
    left: 0;
}

.damage-flash--right {
    right: 0;
}

/* Start countdown, big and centred. Display is toggled by the HUD; only shown during
   the countdown phase and the brief GO! flash. */
.countdown-label {
    position: absolute;
    align-self: center;
    top: 28%;
    font-size: 120px;
    color: #ffffff;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}
