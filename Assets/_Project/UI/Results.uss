/*
 * Road Rash-style results sheet — gold rank chrome on asphalt.
 */
.rank-banner {
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom-width: 2px;
    border-bottom-color: var(--accent-dim);
}

.rank-number {
    font-size: 96px;
    color: var(--accent);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.65);
}

.rule-hint {
    font-size: 16px;
    color: var(--roadrash-blue);
    letter-spacing: 2px;
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}

.payout-panel {
    background-color: rgba(0, 0, 0, 0.35);
    padding: 16px 20px;
    border-width: 1px;
    border-color: rgba(255, 197, 61, 0.35);
    margin-bottom: 12px;
}
