<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd">

    <!-- Theme first, then this screen's layout: later sheets win on equal specificity. -->
    <ui:Style src="Theme.uss" />
    <ui:Style src="MainMenu.uss" />

    <ui:VisualElement class="screen">
        <!-- Decoration first, controls last. Later siblings draw on top AND receive
             picking, so the vignette used to sit over the nav panel and eat every
             button click - the menu would have looked perfect and responded to
             nothing. picking-mode="Ignore" makes that independent of order. -->
        <ui:VisualElement class="background-image" picking-mode="Ignore" />
        <ui:VisualElement class="vignette-overlay" picking-mode="Ignore" />

        <ui:VisualElement class="nav-panel">
            <ui:Label text="HIGHWAY RENEGADE" class="title" />

            <ui:Button name="BtnCampaign" text="CAMPAIGN" class="menu-button" />
            <ui:Button name="BtnGarage" text="GARAGE" class="menu-button" />
            <ui:Button name="BtnSettings" text="SETTINGS" class="menu-button" />
            <ui:Button name="BtnExit" text="EXIT" class="menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
