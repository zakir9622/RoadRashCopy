/*
 * Layout for the title screen. Colours, buttons and type come from Theme.uss - only the
 * things unique to this screen live here.
 */

/*
 * The title backdrop.
 *
 * This used to be `background-image: url('Textures/MainMenuBackground.png')`, pointing at
 * a file that was committed as an unresolved Git LFS pointer - 131 bytes of text that
 * Unity happily imported as a broken texture. So the title screen has never had a
 * background, and nothing anywhere said so.
 *
 * A gradient until a real plate arrives through the asset fetcher. The old image also had
 * buttons painted into the artwork, which fought the live UI Toolkit controls drawn on
 * top of it; the replacement needs to be a clean plate with no UI in it.
 */
.background-image {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: #0b1016;
    background-image: none;
}

.vignette-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
}

/* Anchored left and vertically centred rather than laid out in a flow, so the artwork
   behind it stays visible on a wide phone screen. */
.nav-panel {
    position: absolute;
    left: 100px;
    top: 50%;
    translate: 0 -50%;
    width: 400px;
    padding: 30px;
    background-color: var(--panel);
    border-left-width: 4px;
    border-left-color: var(--accent);
}
