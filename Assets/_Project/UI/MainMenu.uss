.menu-container {
    width: 100%;
    height: 100%;
    position: absolute;
}

.background-image {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: resource("UI/Textures/MainMenuBackground"); /* Needs to be in a Resources folder, or assigned directly in the editor, we'll assign via USS url */
    background-image: url('Textures/MainMenuBackground.png');
    -unity-background-scale-mode: scale-and-crop;
}

.vignette-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
}

.nav-panel {
    position: absolute;
    left: 100px;
    top: 50%;
    translate: 0 -50%;
    width: 400px;
    padding: 30px;
    background-color: rgba(10, 15, 20, 0.85);
    border-left-width: 4px;
    border-left-color: #00ffcc;
}

.title-label {
    font-size: 48px;
    color: #ffffff;
    -unity-font-style: bold;
    margin-bottom: 40px;
    letter-spacing: 2px;
}

.menu-button {
    font-size: 24px;
    color: #a0a0a0;
    background-color: transparent;
    border-width: 0;
    -unity-text-align: middle-left;
    padding: 15px 0;
    margin: 5px 0;
    transition-property: color, padding-left;
    transition-duration: 0.2s;
}

.menu-button:hover {
    color: #00ffcc;
    padding-left: 20px;
}

.menu-button:active {
    color: #ffffff;
}
