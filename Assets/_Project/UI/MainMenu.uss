/*
 * Layout for the title screen. Colours, buttons and type come from Theme.uss - only the
 * things unique to this screen live here.
 */

.background-image {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url('Textures/MainMenuBackground.png');
    -unity-background-scale-mode: scale-and-crop;
}

.vignette-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
}

/* Anchored left and vertically centred rather than laid out in a flow, so the artwork
   behind it stays visible on a wide phone screen. */
.nav-panel {
    position: absolute;
    left: 100px;
    top: 50%;
    translate: 0 -50%;
    width: 400px;
    padding: 30px;
    background-color: var(--panel);
    border-left-width: 4px;
    border-left-color: var(--accent);
}
