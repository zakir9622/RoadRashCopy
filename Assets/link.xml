<!--
  IL2CPP managed-code stripping preservation.

  SaveData and its nested types are (de)serialised by JsonUtility, which finds fields by
  reflection. Managed stripping cannot see those reflective accesses, so under anything
  above Low it can remove fields JsonUtility then fails to populate - and the failure only
  shows on device, never in the editor. BuildScript sets Low stripping; this preserves the
  whole Core assembly as well, belt and braces, so the save types survive whatever the
  stripping level becomes. Core is small and pure-C#, so preserving all of it costs almost
  nothing in binary size.
-->
<linker>
  <assembly fullname="HighwayRenegade.Core" preserve="all" />
</linker>
