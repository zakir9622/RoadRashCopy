; Highway Renegade — Road Rash-style combat racer.
; Godot 4.7, GDScript, Mobile renderer for Android.

config_version=5

[application]

config/name="Highway Renegade"
run/main_scene="res://src/ui/MainMenu.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.043, 0.055, 0.071, 1)
config/icon="res://assets/icon.svg"

[autoload]

GameState="*res://src/autoload/game_state.gd"
RaceContext="*res://src/autoload/race_context.gd"
AudioDirector="*res://src/autoload/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

